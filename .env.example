NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the client.
# Required by the admin Student Data export (/admin/students).
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin portal (/admin/signin). Server-only. ---
# Defaults to admin@calibiai.local / admin@90 for local testing.
# Always override these in any deployed environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: signs the admin session cookie. Set a long random value in production.
ADMIN_SESSION_SECRET=

# --- AI provider: DeepSeek (OpenAI-compatible). Server-only. ---
# Create a key at https://platform.deepseek.com (add credits first, then API keys).
DEEPSEEK_API_KEY=
# deepseek-chat (V3, default) for structured JSON tasks; deepseek-reasoner (R1) for harder reasoning.
DEEPSEEK_MODEL_ID=deepseek-chat
# Override only when routing through a proxy or self-hosted gateway.
DEEPSEEK_BASE_URL=https://api.deepseek.com
